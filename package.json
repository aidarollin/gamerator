{
  "name": "gamerator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check": "npm run typecheck && npm run lint && npm run check:ds && npm run check:tokens && npm run test",
    "tokens": "node scripts/generate-tokens.mjs",
    "check:ds": "node scripts/check-ds.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/generate-fixture-index.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
